root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false

[*.{js,mjs,css,html}]
indent_style = tab
indent_size = 4

[jsconfig*.json]
indent_style = tab
indent_size = 4

[scripts/{bootstrap-template,sync-engine}.mjs]
indent_style = space
indent_size = 2
