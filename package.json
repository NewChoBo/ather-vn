{
  "name": "ather-vn",
  "version": "0.1.0",
  "private": true,
  "description": "AETHER SIGNAL — Monogatari 기반 공개 웹 비주얼 노벨 프로젝트",
  "scripts": {
    "bootstrap": "npm run bootstrap:template && npm run sync:engine",
    "bootstrap:template": "node scripts/bootstrap-template.mjs",
    "sync:engine": "node scripts/sync-engine.mjs",
    "postinstall": "npm run sync:engine",
    "dev": "vn-components-dev --root . --port 5173",
    "lint": "npm run lint:editorconfig",
    "lint:editorconfig": "editorconfig-checker",
    "test": "node --test tests/**/*.test.mjs",
    "test:pages": "node --test tests/pages-output.verify.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "validate": "npm run lint && npm run test && npm run build:pages && npm run test:pages"
  },
  "dependencies": {
    "@monogatari/core": "2.8.0",
    "@newchobo/vn-components": "https://github.com/NewChoBo/vn-component-kit/archive/bd15118116ae4a9efa196eb54513b02bb7ec5c40.tar.gz"
  },
  "devDependencies": {
    "editorconfig-checker": "6.1.1",
    "serve": "14.2.6"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
